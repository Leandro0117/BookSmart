    bs:hasTheme "Familia" ;
    bs:hasTheme "Tiempo" ;
    bs:hasAdaptation bs:Adaptation1 ;
    dct:description "La historia de la familia Buendía en el pueblo ficticio de Macondo. Tiene adaptación al cine programada para 2024." .

